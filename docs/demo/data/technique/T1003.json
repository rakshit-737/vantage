{"id":"T1003","name":"OS Credential Dumping","tactics":["credential-access"],"description":"Adversaries may attempt to dump credentials to obtain account login and credential material, normally in the form of a hash or a clear text password. Credentials can be obtained from OS caches, memory, or structures. Credentials can then be used to perform Lateral Movement and access restricted information. Several of the tools mentioned in associated sub-techniques may be used by both adversaries and professional security testers. Additional custom tools likely exist as well.","status":"defended","claimed_by":[{"id":"CIS-11.3","title":""},{"id":"CIS-14.1","title":""},{"id":"CIS-14.3","title":""},{"id":"CIS-16.1","title":""},{"id":"CIS-16.9","title":""},{"id":"CIS-18.3","title":""},{"id":"CIS-2.6","title":""},{"id":"CIS-3.11","title":""},{"id":"CIS-3.12","title":""},{"id":"CIS-4.1","title":""},{"id":"CIS-4.7","title":""},{"id":"CIS-4.8","title":""},{"id":"CIS-5.2","title":""},{"id":"CIS-5.3","title":""},{"id":"CIS-5.4","title":""},{"id":"CIS-6.1","title":""},{"id":"CIS-6.2","title":""}],"live_rules":[{"id":"1de68c67-af5c-4097-9c85-fe5578e09e67","title":"WCE wceaux.dll Access","level":"critical","requires":["windows/security"]},{"id":"c1182e02-49a3-481c-b3de-0fadc4091488","title":"Rare Subscription-level Operations In Azure","level":"medium","requires":["azure/activitylogs"]}],"dead_rules":[{"id":"0442defa-b4a2-41c9-ae2c-ea7042fc4701","title":"Potential Credential Dumping Attempt Using New NetworkProvider - REG","level":"medium","requires":["windows/registry_set"]},{"id":"189e3b02-82b2-4b90-9662-411eb64486d4","title":"Potential Invoke-Mimikatz PowerShell Script","level":"high","requires":["windows/ps_script"]},{"id":"24e3e58a-646b-4b50-adef-02ef935b9fc8","title":"Hacktool Execution - Imphash","level":"critical","requires":["windows/process_creation"]},{"id":"2617e7ed-adb7-40ba-b0f3-8f9945fe6c09","title":"Suspicious SYSTEM User Process Creation","level":"high","requires":["wind