{"id":"T1573","name":"Encrypted Channel","tactics":["command-and-control"],"description":"Adversaries may employ an encryption algorithm to conceal command and control traffic rather than relying on any inherent protections provided by a communication protocol. Despite the use of a secure algorithm, these implementations may be vulnerable to reverse engineering if secret keys are encoded and/or generated within malware samples/configuration files.","status":"defended","claimed_by":[{"id":"CIS-13.3","title":""}],"live_rules":[{"id":"0f2468a2-5055-4212-a368-7321198ee706","title":"Activity from Infrequent Country","level":"medium","requires":["m365/threat_management"]},{"id":"a3501e8e-af9e-43c6-8cd6-9360bdaae498","title":"Activity from Suspicious IP Addresses","level":"medium","requires":["m365/threat_detection"]},{"id":"d8b0a4fe-07a8-41be-bd39-b14afa025d95","title":"Activity from Anonymous IP Addresses","level":"medium","requires":["m365/threat_management"]}],"dead_rules":[{"id":"cae6cee6-0244-44d2-84ed-e65f548eb7dc","title":"Potential Pikabot C2 Activity","level":"high","requires":["windows/network_connection"]}],"subtechniques":[{"id":"T1573.001","name":"Encrypted Channel: Symmetric Cryptography","status":"paper_only"},{"id":"T1573.002","name":"Encrypted Channel: Asymmetric Cryptography","status":"paper_only"}]}