{"id":"T1087","name":"Account Discovery","tactics":["discovery"],"description":"Adversaries may attempt to get a listing of valid accounts, usernames, or email addresses on a system or within a compromised environment. This information can help adversaries determine which accounts exist, which can aid in follow-on behavior such as brute-forcing, spear-phishing attacks, or account takeovers (e.g., Valid Accounts). Adversaries may use several methods to enumerate accounts, including abuse of existing tools, built-in commands, and potential misconfigurations that leak account names and roles or permissions in the targeted environment. For examples, cloud environments typical","status":"defended","claimed_by":[{"id":"CIS-18.3","title":""},{"id":"CIS-4.1","title":""},{"id":"CIS-4.8","title":""}],"live_rules":[{"id":"24549159-ac1b-479c-8175-d42aea947cae","title":"Hacktool Ruler","level":"high","requires":["windows/security"]}],"dead_rules":[{"id":"02030f2f-6199-49ec-b258-ea71b07e03dc","title":"Malicious PowerShell Commandlets - ProcessCreation","level":"high","requires":["windows/process_creation"]},{"id":"38646daa-e78f-4ace-9de0-55547b2d30da","title":"PUA - Seatbelt Execution","level":"high","requires":["windows/process_creation"]},{"id":"4ebc877f-4612-45cb-b3a5-8e3834db36c9","title":"Webshell Hacking Activity Patterns","level":"high","requires":["windows/process_creation"]},{"id":"65f77b1e-8e79-45bf-bb67-5988a8ce45a5","title":"SharpHound Recon Account Discovery","level":"high","requires":["rpc_firewall/application"]},{"id":"698d4431-514f-4c82-af4d-cf573872a9f5","title":"Potential Pikabot Discovery Activity","level":"high","requires":["windows/process_creation"]},{"id":"7d0d0329-0ef1-4e84-a9f5-49500f9d7c6c","title":"Malicious PowerShell Commandlets - PoshModule","level":"high","requires":["windows/ps_module"]},{"id":"89819aa4-bbd6-46bc-88ec-c7f7fe30efa6","title":"Malicious PowerShell Commandlets - ScriptBlock","level":"high","requires":["windows/ps_script"]},{"id":"98b53